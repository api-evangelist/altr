                "description": "Service Type"
              },
              {
                "name": "set_active",
                "value": "",
                "type": "query",
                "description": "Set as Active Authentication Method"
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
