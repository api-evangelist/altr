{
  "opencollection": "1.0.0",
  "info": {
    "name": "ALTR Management Configuration API",
    "version": "12.25.1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Returns configuration information for the ALTRNet.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://altrnet.live.altr.com/api/configuration"
          },
          "docs": "Returns configuration information for the ALTRNet."
        }
      ]
    }
  ],
  "bundled": true
}