      "id": "ca3ed699-d2df-4efc-928d-b14ea862c664",
      "name": "Databricks Tag Policy",
      "description": {
        "content": "Operations related to applying tag-based governance policies to Databricks",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a6d1b952-c770-4c8f-beff-563f21854a0a",
          "name": "Start application of a tag-based policy",
          "request": {
            "name": "Start application of a tag-based policy",
            "description": {
              "content": "When `policyAction` is `set`, an asynchronous Databricks job is launched to apply the given `policy` on all columns tagged with `tagName`.<p>When `policyAction` is set to `delete`, `policy` is ignored, and a Databricks job is launched to remove policy configured on tag `tagName`.<p>In either case, the status of the job can be tracked with the `GET` endpoint using the returned `id`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "dbx",
                "tag-policy",
                "apply"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "null",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
