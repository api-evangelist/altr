            "name": "Get Account Locator.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.live.altr.com/v1/snowflake/metadata/:databaseID/accountLocator",
            "params": [
              {
                "name": "databaseID",
                "value": "",
                "type": "path",
                "description": "The ID of a connected database."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get snowflake account locator."
        },
