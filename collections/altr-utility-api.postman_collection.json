  "info": {
    "_postman_id": "e91c0b1e-256b-4661-8f29-e3e8fcebbb71",
    "name": "ALTR Datastore Information Service Utility API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Welcome to the Swagger documentation for ALTR's Datastore Information Service (DIS). DIS provides ALTR customers ways to programmatically access ALTR Classification, Tags, and Masking information via restful API.\n\nDIS does not include the endpoints for ALTR's tokenization API; documentation on ALTR's tokenization API can be found here.\n\nDIS uses HTTP Basic Authentication. DIS uses the same credentials that MAPI uses. MAPI/DIS credentials can be obtained on the API page (found under Settings > Preferences > API) of ALTR's portal for Enterprise and Enterprise + customers. Usernames are the 'Key Names' listed on that page, and Passwords are the 'Key Secret' provided when an API key is created.\n\nContact Support:\n Name: Support\n Email: support@altr.com",
      "type": "text/plain"
    }
  }
