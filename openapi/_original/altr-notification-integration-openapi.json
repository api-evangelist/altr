            "maxLength": 4096,
            "type": "string"
          },
          "oauth_client_credentials": {
            "$ref": "#/components/schemas/models.ServiceNowOAuthClientCreds"
          },
          "table_name": {
            "default": "incident",
            "type": "string"
          }
        },
        "required": [
