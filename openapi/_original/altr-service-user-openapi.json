    "/services/{service}/users/{userID}/auth/{auth}/{authid}/test": {
      "post": {
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "description": "Creates an **asynchronous** job that validates the specified authentication item. The endpoint returns immediately with a job\u2010identifier you can poll later.",
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "tags": [
          "Tasks"
        ],
        "summary": "Start a task which validates the authentication method",
        "parameters": [
          {
            "enum": [
              "snowflake"
            ],
            "type": "string",
            "description": "Service Type",
            "name": "service",
            "in": "path",
            "required": true
          },
          {
            "type": "string",
            "example": "2w6ALEtk50T5ZWyw9cIuvhTjVGt",
            "description": "User ID",
            "name": "userid",
            "in": "path",
            "required": true
          },
          {
            "enum": [
              "password",
              "keypair"
            ],
            "type": "string",
            "description": "Authentication Type",
            "name": "auth",
            "in": "path",
            "required": true
          },
          {
            "type": "string",
            "description": "Authentication ID",
            "name": "authid",
            "in": "path",
            "required": true
          }
        ],
        "responses": {
          "202": {
            "description": "Test job accepted",
            "schema": {
              "$ref": "#/definitions/dto.CreateAuthTestJobResponse"
            }
          },
          "404": {
            "description": "Authentication item not found",
            "schema": {
              "$ref": "#/definitions/dto.Error"
            }
          },
          "409": {
            "description": "Test already in progress or overlapping request",
            "schema": {
              "$ref": "#/definitions/dto.Error"
            }
          },
          "500": {
            "description": "Unexpected server error",
            "schema": {
              "$ref": "#/definitions/dto.Error"
            }
          },
          "503": {
            "description": "Service unavailable",
            "schema": {
              "$ref": "#/definitions/dto.Error"
            }
          }
        }
      }
    },
